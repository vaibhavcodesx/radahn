# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=                     # mongodb+srv://...  (Atlas M0)
MONGODB_DB=radahn                # radahn_eval for evals
GEMINI_API_KEYS=                 # comma-separated; one per Google project; rotated on 429
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
BETTER_AUTH_SECRET=              # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=                     # openssl rand -base64 32
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEMORY_ENGINE=mock               # mock | real
VOYAGE_API_KEY=                  # optional: stage-2 reranker
